# SyncBridge Platform example environment
# Do not commit real secrets. Use strong unique values in real environments.

NODE_ENV=development
PORT=4100

# Database / Redis
DATABASE_URL=postgresql://syncbridge:syncbridge@localhost:5433/syncbridge?schema=public
REDIS_URL=redis://localhost:6380

# Queue / worker
QUEUE_MODE=sync
BULLMQ_REDIS_URL=redis://localhost:6380
BULLMQ_DEFAULT_ATTEMPTS=3
BULLMQ_BACKOFF_MS=5000

# Scheduler
SCHEDULER_ENABLED=false
SCHEDULER_POLL_INTERVAL_SECONDS=30
SCHEDULER_LOCK_TTL_SECONDS=60

# Auth (replace for non-demo use)
JWT_ACCESS_SECRET=replace_me_access_secret
JWT_REFRESH_SECRET=replace_me_refresh_secret

# CORS (comma-separated)
CORS_ORIGIN=http://localhost:3001

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:4100/api